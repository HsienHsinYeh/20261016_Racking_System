{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "20261016-racking-system",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
